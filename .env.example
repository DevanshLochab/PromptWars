# ==============================================================================
# PRIMARY AI PROVIDER: Google Gemini API
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.0-flash-lite
GEMINI_MODEL_LIVE=gemini-2.0-flash-live-001
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# ==============================================================================
# BACKUP AI PROVIDER 1: Mistral AI API
# ==============================================================================
MISTRAL_API_KEY=
MISTRAL_MODEL_MAIN=mistral-large-latest
MISTRAL_MODEL_FAST=mistral-small-latest

# ==============================================================================
# BACKUP AI PROVIDER 2: NVIDIA AI API (GLM & GLM Fast via NVIDIA NIM)
# ==============================================================================
NVIDIA_API_KEY=
NVIDIA_MODEL_MAIN=thudm/glm-4-9b-chat
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct

# ==============================================================================
# OPTIONAL DIRECT GLM PROVIDER: Zhipu AI (GLM-4 & GLM-4-Flash)
# ==============================================================================
GLM_API_KEY=
GLM_MODEL_MAIN=glm-4-plus
GLM_MODEL_FAST=glm-4-flash

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Pre-seeded offline demo data (Delhi winter severe smog snapshot Jan 15)
DEMO_MODE=true

